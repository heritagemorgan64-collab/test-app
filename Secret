<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Sequence AI Analyzer</title>
<style>
  *{box-sizing:border-box}
  body{margin:0;font-family:Arial,sans-serif;background:#f4f7fb;color:#172033}
  header{background:#172033;color:white;padding:24px 18px;text-align:center}
  header h1{margin:0 0 7px;font-size:28px}
  header p{margin:0;color:#cbd5e1}
  main{max-width:1000px;margin:20px auto;padding:0 14px}
  .card{background:white;border-radius:16px;padding:20px;margin-bottom:18px;box-shadow:0 4px 18px #00000012}
  h2{margin-top:0}
  textarea{width:100%;min-height:130px;border:1px solid #cbd5e1;border-radius:10px;padding:12px;font-size:16px;resize:vertical}
  button,.file-label{display:inline-block;border:0;border-radius:10px;padding:12px 18px;background:#2563eb;color:white;font-weight:bold;cursor:pointer;margin-top:10px}
  button.secondary{background:#475569}
  input[type=file]{display:none}
  video{width:100%;max-height:360px;border-radius:12px;background:#0f172a;margin-top:14px}
  .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px}
  .stat{background:#f8fafc;border-radius:12px;padding:15px;border:1px solid #e2e8f0}
  .stat b{display:block;font-size:22px;margin-top:5px}
  .result{padding:14px;background:#eff6ff;border-left:4px solid #2563eb;border-radius:8px;margin:10px 0}
  .warning{background:#fff7ed;border-left-color:#f97316}
  .small{font-size:13px;color:#64748b}
  ul{padding-left:20px}
</style>
</head>
<body>
<header>
  <h1>Sequence AI Analyzer</h1>
  <p>Analyze numbers for repetition, sequences, cycles, trends and anomalies.</p>
</header>

<main>
  <section class="card">
    <h2>1. Enter your data</h2>
    <p class="small">Enter numbers separated by commas, spaces, or new lines.</p>
    <textarea id="data" placeholder="Example: 2, 4, 6, 8, 10, 12, 2, 4, 6"></textarea>
    <br>
    <button onclick="analyze()">Analyze Data</button>
    <button class="secondary" onclick="clearAll()">Clear</button>
  </section>

  <section class="card">
    <h2>2. Screen recording</h2>
    <p class="small">Upload a screen recording to preview it. This version does not yet automatically read numbers from video; OCR can be added in the next version.</p>
    <label class="file-label" for="videoInput">Choose Screen Recording</label>
    <input id="videoInput" type="file" accept="video/*">
    <video id="video" controls style="display:none"></video>
  </section>

  <section class="card" id="results" style="display:none">
    <h2>Analysis</h2>
    <div class="grid">
      <div class="stat">Data points<b id="count">0</b></div>
      <div class="stat">Unique values<b id="unique">0</b></div>
      <div class="stat">Most common<b id="common">—</b></div>
      <div class="stat">Average<b id="average">—</b></div>
    </div>
    <div id="findings"></div>
  </section>
</main>

<script>
const videoInput = document.getElementById("videoInput");
const video = document.getElementById("video");

videoInput.addEventListener("change", () => {
  const file = videoInput.files[0];
  if (!file) return;
  video.src = URL.createObjectURL(file);
  video.style.display = "block";
});

function getNumbers() {
  return document.getElementById("data").value
    .split(/[,\\s;]+/)
    .map(x => Number(x.trim()))
    .filter(x => Number.isFinite(x));
}

function approx(a,b,tol=1e-9){ return Math.abs(a-b) <= tol; }

function frequency(arr) {
  const m = new Map();
  arr.forEach(x => m.set(x,(m.get(x)||0)+1));
  return [...m.entries()].sort((a,b)=>b[1]-a[1]);
}

function detectArithmetic(a) {
  if(a.length < 3) return null;
  const d = a[1]-a[0];
  return a.every((x,i)=>i<2 || approx(x-a[i-1],d)) ? d : null;
}

function detectGeometric(a) {
  if(a.length < 3 || a[0] === 0) return null;
  const r = a[1]/a[0];
  if(!Number.isFinite(r)) return null;
  return a.every((x,i)=>i<2 || approx(x/a[i-1],r)) ? r : null;
}

function smallestRepeatingPeriod(a) {
  for(let p=1;p<=Math.floor(a.length/2);p++){
    let ok=true;
    for(let i=p;i<a.length;i++){
      if(!approx(a[i],a[i%p])) {ok=false;break;}
    }
    if(ok) return p;
  }
  return null;
}

function longestRun(a) {
  let best={value:a[0],length:1}, cur={value:a[0],length:1};
  for(let i=1;i<a.length;i++){
    if(approx(a[i],a[i-1])) cur.length++;
    else cur={value:a[i],length:1};
    if(cur.length>best.length) best={...cur};
  }
  return best;
}

function analyze() {
  const a=getNumbers();
  const results=document.getElementById("results");
  const findings=document.getElementById("findings");
  if(a.length<2){
    alert("Please enter at least 2 numbers.");
    return;
  }

  results.style.display="block";
  findings.innerHTML="";
  document.getElementById("count").textContent=a.length;
  document.getElementById("unique").textContent=new Set(a).size;

  const freq=frequency(a);
  document.getElementById("common").textContent =
    `${freq[0][0]} (${freq[0][1]}×)`;

  const avg=a.reduce((s,x)=>s+x,0)/a.length;
  document.getElementById("average").textContent=avg.toFixed(4);

  addFinding(`Sequence preview: ${a.slice(0,20).join(", ")}${a.length>20?" …":""}`);

  const ar=detectArithmetic(a);
  if(ar!==null){
    addFinding(`Arithmetic sequence detected. Constant difference: ${ar}. Next-value estimate: ${a[a.length-1]+ar}.`);
  } else {
    addFinding("No simple arithmetic sequence detected.");
  }

  const geo=detectGeometric(a);
  if(geo!==null){
    addFinding(`Geometric sequence detected. Constant ratio: ${geo}. Next-value estimate: ${a[a.length-1]*geo}.`);
  }

  const period=smallestRepeatingPeriod(a);
  if(period){
    addFinding(`Repeating cycle detected with a period of ${period}: ${a.slice(0,period).join(", ")}.`);
  } else {
    addFinding("No exact repeating cycle was found.");
  }

  const run=longestRun(a);
  if(run.length>=2){
    addFinding(`Longest consecutive repeat: ${run.value} appears ${run.length} times in a row.`);
  }

  const changes=a.slice(1).map((x,i)=>x-a[i]);
  if(changes.length){
    const avgChange=changes.reduce((s,x)=>s+x,0)/changes.length;
    addFinding(`Average change between consecutive values: ${avgChange.toFixed(4)}.`);
  }

  const outliers=detectOutliers(a);
  if(outliers.length){
    addFinding(`Potential statistical outliers: ${outliers.join(", ")}.`,true);
  } else {
    addFinding("No strong statistical outliers detected.");
  }

  addFinding("Important: pattern detection describes mathematical patterns in the supplied data. It does not guarantee what the next real-world event will be.",true);
}

function detectOutliers(a){
  if(a.length<5) return [];
  const sorted=[...a].sort((x,y)=>x-y);
  const q1=percentile(sorted,.25), q3=percentile(sorted,.75);
  const iqr=q3-q1, low=q1-1.5*iqr, high=q3+1.5*iqr;
  return a.filter(x=>x<low || x>high);
}

function percentile(a,p){
  const pos=(a.length-1)*p, base=Math.floor(pos), rest=pos-base;
  return a[base] + (a[base+1]!==undefined ? rest*(a[base+1]-a[base]) : 0);
}

function addFinding(text,warning=false){
  const div=document.createElement("div");
  div.className="result"+(warning?" warning":"");
  div.textContent=text;
  document.getElementById("findings").appendChild(div);
}

function clearAll(){
  document.getElementById("data").value="";
  document.getElementById("results").style.display="none";
  video.pause();
  video.removeAttribute("src");
  video.load();
  video.style.display="none";
  videoInput.value="";
}
</script>
</body>
</html>
